<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect /archive and /archive/* to /#past
  RewriteRule ^archive(/.*)?$ /#past [R=301,L,NE]

  # Standard SPA fallback for Angular / Microfrontend
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>
